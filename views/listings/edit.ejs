<%layout("layouts/boilerPlate") -%>

  <div class="row mt-3">
    <div class="col-8 offset-2">
      <h3>Edit your Listing</h3>
      <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="mb-3">
          <label for="title" class="form-label" place>Title</label>
          <input name="listing[title]" value="<%= listing.title %>" type="text" class="form-control" required />
          <div class="valid-feedback">Title looks good!</div>
          <div class="invalid-feedback">Plese Enter valid Title!!</div>
        </div>
        <div class="mb-3">
          <label for="description" class="form-label" place>Description</label>
          <textarea name="listing[description]" class="form-control" required><%= listing.description %></textarea>
          <div class="valid-feedback">Description looks good!</div>
          <div class="invalid-feedback">Plese Enter a short Description!!</div>
        </div>
        <div class="mb-3">
          <label for="image" class="form-label" place>Original Image</label><br>
          <image src="<%= originalImageUrl%>"></image>
        </div>
        <div class="mb-3">
          <label for="image" class="form-label" place>Upload New Image</label>
          <input name="listing[image]" type="file" class="form-control" />
        </div>
        <div class="row">
          <div class="mb-3 col-md-4">
            <label for="price" class="form-label" place>Price</label>
            <input name="listing[price]" value="<%= listing.price %>" class="form-control" required />
            <div class="valid-feedback">Price looks good!</div>
            <div class="invalid-feedback">Plese Enter valid Price!!</div>
          </div>
          <div class="mb-3 col-md-4">
            <label for="country" class="form-label" place>Country</label>
            <input name="listing[country]" value="<%= listing.country %>" type="text" class="form-control" required />
            <div class="valid-feedback">Country looks good!</div>
            <div class="invalid-feedback">Plese Enter valid Country!!</div>
          </div>
        </div>
        <div class="mb-3">
          <label for="location" class="form-label" place>Location</label>
          <input name="listing[location]" value="<%= listing.location %>" type="text" class="form-control" required />
          <div class="valid-feedback">Location looks good!</div>
          <div class="invalid-feedback">Plese Enter valid Location!!</div>
        </div>
        <button class="btn btn-dark edit-btn mt-3">Edit</button>
      </form>
    </div>
  </div>